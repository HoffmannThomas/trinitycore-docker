COMPOSE_PROJECT_NAME=trinitycore
# TrinityCore Docker - Environment Configuration
# Copy this file to .env and fill in your values
# .env is gitignored and will not be committed

# Server configuration
SERVER_IP=192.168.1.100

# Database
MYSQL_ROOT_PASSWORD=trinity
DB_HOST=db
DB_PORT=3306
DB_USER=trinity
DB_PASS=trinity
DB_NAME_AUTH=auth
DB_NAME_WORLD=world
DB_NAME_CHAR=characters
DB_NAME_HOTFIX=hotfixes

# Paths (on host)
TC_ETC_PATH=./tc-etc
TC_DATA_PATH=./tc-data
WOW_CLIENT_PATH=/mnt/wow-client

# Certificate paths
CERT_PATH=./certs
